==>  Preparing: SELECT p.name, p.gender, p.age, p.id_card_number, pa.chief_complaint AS preoperative_diagnosis, t.surgery_method AS planned_surgery, t.anesthesia_method AS anesthesia_method, t.surgery_start_time, t.surgery_end_time, (SELECT MAX(time) FROM waveform_parameter WHERE treatment_information_id = t.treatment_information_id) AS recovery_end_time, TRIM(BOTH ',' FROM CONCAT_WS(',', CASE WHEN pa.his_is_hypertension THEN '高血压' ELSE NULL END, CASE WHEN pa.his_is_chronic_bronchitis THEN '慢支炎' ELSE NULL END, CASE WHEN pa.his_is_osas THEN 'OSAS' ELSE NULL END, CASE WHEN pa.his_is_diabetes THEN '糖尿病' ELSE NULL END, CASE WHEN pa.his_is_asthma THEN '哮喘' ELSE NULL END, CASE WHEN pa.his_is_stroke THEN '脑中风' ELSE NULL END, CASE WHEN pa.his_is_coronary_heart_disease THEN '冠心病' ELSE NULL END, CASE WHEN pa.his_is_arrhythmia THEN '心律失常' ELSE NULL END, CASE WHEN pa.his_is_copd THEN 'COPD' ELSE NULL END, CASE WHEN pa.his_is_peptic_ulcer THEN '消化性溃疡' ELSE NULL END, CASE WHEN pa.his_is_thyroid_dysfunction THEN '甲亢甲减' ELSE NULL END, CASE WHEN pa.his_is_hematemesis_or_melena THEN '呕血黑便' ELSE NULL END, NULLIF(pa.his_others, '') )) AS preoperative_special_condition, -- 恢复室评估字段（recovery_area_room_assessment） ra.bp, ra.p_bpm, ra.r_bpm, ra.spo2, ra.anesthesia_satisfaction, ra.vas_score, ra.recovery_conscious, ra.skin_condition, ra.steward_score, ra.awakening_level, ra.airway_patency, ra.limb_activity, ra.pupil_light_reflex, ra.respiration_vt, ra.muscle_strength, ra.top_ratio, ra.respiration_sound, ra.reflex, ra.sound, ra.self_report_ability, ra.consciousness_orientation, ra.spatial_orientation, ra.calculation_ability, ra.memory, ra.pupil_equal FROM treatment_information t JOIN paa_information pa ON pa.treatment_information_id = t.treatment_information_id JOIN patient p ON p.patient_id = t.patient_id LEFT JOIN recovery_area_room_assessment ra ON ra.treatment_information_id = t.treatment_information_id WHERE t.treatment_information_id = ? LIMIT 1
